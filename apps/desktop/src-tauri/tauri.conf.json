{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeerSpan",
  "version": "0.1.0",
  "identifier": "com.peerspan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "PeerSpan 邻屏",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
